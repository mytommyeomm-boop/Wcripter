local function handleSound(s)
    if not CONFIG.MuteWorkspaceSFX and not CONFIG.MuteSFX then return end
    if isProtected(s) or isLocalChar(s) then return end
    if CONFIG.SoundMuteMode == "Destroy" or CONFIG.MuteSFX then
        pcall(function() s.Volume = 0; s.Playing = false; s:Destroy() end)
    else
        if not CLAY.OriginalSound[s] then CLAY.OriginalSound[s] = s.Volume end
        pcall(function() s.Volume = 0 end)
    end
end

local function scanSounds(root)
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("Sound") then handleSound(d) end
    end
end

