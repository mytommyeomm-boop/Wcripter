local function isBall(name)
    name = name:lower()
    return name:find("ball") or name:find("soccer") or name:find("football")
end

local function createBallProxy(realBall)
    local p = Instance.new("Part")
    p.Name = "CLAY_BALLPROXY"
    p.Size = realBall.Size
    p.Color = realBall.Color
    p.Material = Enum.Material.SmoothPlastic
    p.Transparency = realBall.Transparency
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.Anchored = true
    p.CastShadow = false
    p.CFrame = realBall.CFrame
    p.Parent = Workspace
    return p
end

local function initBall(realBall)
    if CLAY.BallData[realBall] then return end
    if not CONFIG.BallSmoothing then
        if CONFIG.BallHighlight then
            local hl = Instance.new("Highlight")
            hl.Name = "CLAY_HL"
            hl.FillColor = Color3.fromRGB(255,255,80)
            hl.FillTransparency = 0.75
            hl.OutlineColor = Color3.fromRGB(255,255,80)
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = realBall
            hl.Parent = realBall
        end
        if CONFIG.EnableHitbox and not realBall:FindFirstChild("CLAY_HB") then
            local wrap = Instance.new("Part")
            wrap.Name = "CLAY_HB"
            wrap.Size = realBall.Size + Vector3.new(CONFIG.HitboxAmount, CONFIG.HitboxAmount, CONFIG.HitboxAmount)
            wrap.Transparency = 1
            wrap.CanCollide = false; wrap.CanTouch = true; wrap.CanQuery = false
            wrap.Anchored = false; wrap.Massless = true
            wrap.CFrame = realBall.CFrame
            local weld = Instance.new("WeldConstraint")
            weld.Part0, weld.Part1 = wrap, realBall
            weld.Parent = wrap
            wrap.Parent = realBall
        end
        return
    end

    local proxy = createBallProxy(realBall)
    realBall.LocalTransparencyModifier = 1

    if CONFIG.BallHighlight then
        local hl = Instance.new("Highlight")
        hl.Name = "CLAY_HL"
        hl.FillColor = Color3.fromRGB(255,255,80)
        hl.FillTransparency = 0.75
        hl.OutlineColor = Color3.fromRGB(255,255,80)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = proxy
        hl.Parent = proxy
    end

    local now = os.clock()
    CLAY.BallData[realBall] = {
        proxy = proxy,
        history = { { t = now, pos = realBall.CFrame.Position, rot = realBall.CFrame.Rotation } },
        smoothVel = Vector3.new(),
        lastSample = now,
        hitbox = nil,
        isShot = false,
    }

    if CONFIG.EnableHitbox and CONFIG.HitboxSmoothFollow and not proxy:FindFirstChild("CLAY_HB") then
        local wrap = Instance.new("Part")
        wrap.Name = "CLAY_HB"
        wrap.Size = proxy.Size + Vector3.new(CONFIG.HitboxAmount, CONFIG.HitboxAmount, CONFIG.HitboxAmount)
        wrap.Transparency = 1
        wrap.CanCollide = false; wrap.CanTouch = true; wrap.CanQuery = false
        wrap.Anchored = true; wrap.Massless = true
        wrap.CFrame = proxy.CFrame
        wrap.Parent = proxy
        CLAY.BallData[realBall].hitbox = wrap
    end
end

local function sampleBall(realBall)
    local d = CLAY.BallData[realBall]
    if not d or not realBall.Parent then return end
    local now = os.clock()
    local pos = realBall.CFrame.Position
    local rot = realBall.CFrame.Rotation
    local last = d.history[#d.history]

    if last then
        local dt = now - last.t
        if dt > 0.001 then
            local instVel = (pos - last.pos) / dt
            if instVel.Magnitude < 800 then
                d.smoothVel = d.smoothVel:Lerp(instVel, CONFIG.BallVelocityEMA)
            else
                d.smoothVel = Vector3.new()
                d.history = {}
            end
        end
    end

    table.insert(d.history, { t = now, pos = pos, rot = rot })
    if #d.history > 15 then table.remove(d.history, 1) end
    d.lastSample = now
    d.isShot = d.smoothVel.Magnitude > CONFIG.BallShotSpeedThreshold
end

local function renderBalls()
    if not CONFIG.BallSmoothing then return end
    local now = os.clock()
    local lpChar = LP.Character
    local lpPos = lpChar and lpChar.PrimaryPart and lpChar.PrimaryPart.Position
    local pingLead = CONFIG.BallCompensatePing
        and (math.max(0, CLAY.Stats.ping) / 2000) or 0

    for realBall, d in pairs(CLAY.BallData) do
        if not realBall.Parent or not d.proxy or not d.proxy.Parent then
            if d.proxy then d.proxy:Destroy() end
            pcall(function() realBall.LocalTransparencyModifier = 0 end)
            CLAY.BallData[realBall] = nil
            continue
        end

        local delay = CONFIG.BallBaseDelay
        if lpPos then
            local dist = (realBall.CFrame.Position - lpPos).Magnitude
            if dist < CONFIG.BallNearDistance then
                delay = CONFIG.BallNearDelay
            elseif dist > CONFIG.BallFarDistance then
                delay = CONFIG.BallFarDelay
            else
                local t = (dist - CONFIG.BallNearDistance) / (CONFIG.BallFarDistance - CONFIG.BallNearDistance)
                delay = CONFIG.BallNearDelay * (1 - t) + CONFIG.BallFarDelay * t
            end
        end
        if d.isShot then delay = delay * CONFIG.BallShotDelayReduction end

        local renderTime
        if CONFIG.BallPredictionMode == "Lead" then
            renderTime = now + pingLead - delay
        elseif CONFIG.BallPredictionMode == "Lag" then
            renderTime = now - delay - pingLead
        else
            renderTime = now
        end

        local minT = now - CONFIG.BallMaxDelay
        local maxT = now + CONFIG.BallMaxExtrapolate + pingLead
        if renderTime < minT then renderTime = minT end
        if renderTime > maxT then renderTime = maxT end

        local h = d.history
        if #h < 2 then
            d.proxy.CFrame = realBall.CFrame
        else
            local prev, nxt = h[1], h[#h]
            local found = false
            for i = 1, #h - 1 do
                if h[i].t <= renderTime and h[i+1].t >= renderTime then
                    prev, nxt = h[i], h[i+1]
                    found = true
                    break
                end
            end

            local finalCF
            if found then
                local span = nxt.t - prev.t
                local alpha = span > 0.0001 and (renderTime - prev.t) / span or 0
                if alpha < 0 then alpha = 0 elseif alpha > 1 then alpha = 1 end
                local pos = prev.pos:Lerp(nxt.pos, alpha)
                local rot = prev.rot:Lerp(nxt.rot, alpha)
                finalCF = CFrame.new(pos) * rot
            else
                local dt = renderTime - h[#h].t
                if dt < 0 then dt = 0 end
                if dt > CONFIG.BallMaxExtrapolate then dt = CONFIG.BallMaxExtrapolate end
                local pos = h[#h].pos + d.smoothVel * dt
                finalCF = CFrame.new(pos) * h[#h].rot
            end
            d.proxy.CFrame = finalCF
        end

        if d.hitbox and d.hitbox.Parent then
            d.hitbox.CFrame = d.proxy.CFrame
        end
    end
end

