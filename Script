function CLAY:Restore()
    print("[CLAY-FPS] ♻️ คืนค่าสภาพเดิม...")
    local restored = 0
    for part, orig in pairs(self.OriginalMaterial) do
        if part and part.Parent then
            pcall(function()
                part.Material = orig.Material
                part.Reflectance = orig.Reflectance
                part.CastShadow = orig.CastShadow
                part.Color = orig.Color
                if orig.TextureID and part:IsA("MeshPart") then
                    part.TextureID = orig.TextureID
                end
            end)
            restored = restored + 1
        end
    end
    self.OriginalMaterial = setmetatable({}, {__mode = "k"})
    for snd, vol in pairs(self.OriginalSound) do
        if snd and snd.Parent then
            pcall(function() snd.Volume = vol end)
            restored = restored + 1
        end
    end
    self.OriginalSound = setmetatable({}, {__mode = "k"})
    for light in pairs(self.HiddenLights) do
        if light and light.Parent then
            pcall(function() light.Enabled = true end)
            restored = restored + 1
        end
    end
    self.HiddenLights = setmetatable({}, {__mode = "k"})
    for char, rec in pairs(self.FrozenChars) do
        if char and char.Parent and type(rec) == "table" then
            pcall(function()
                for _, track in ipairs(rec.tracks or {}) do
                    pcall(function() track:AdjustSpeed(1) end)
                end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
                end
            end)
            restored = restored + 1
        end
    end
    self.FrozenChars = setmetatable({}, {__mode = "k"})
    print(("[CLAY-FPS] ♻️ คืน %d รายการ"):format(restored))
    if CONFIG.ShowToast then
        self:Notify(("♻️ คืนสภาพเดิม %d รายการ"):format(restored), {
            color = Color3.fromRGB(120,200,255), duration = 5 })
    end
end

