local function applyFFlags()
    if type(setfflag) ~= "function" then return end
    if CONFIG.UncapFPS then
        pcall(setfflag, "DFIntTaskSchedulerTargetFps", "240")
        pcall(setfflag, "FFlagGameBasicSettingsFramerateCap", "false")
    end
    if CONFIG.QualityLevel <= 1 then
        pcall(setfflag, "DFIntMaxFrameBufferSize", "4")
        pcall(setfflag, "FFlagDisablePostFx", "true")
    end
    if CONFIG.MorePingFFlags then
        pcall(setfflag, "DFIntS2PhysicsSenderRate", "5")
        pcall(setfflag, "DFIntS2PhysicsReceiverRate", "5")
        pcall(setfflag, "DFIntMaxDataPacketsPerSecond", "30")
        pcall(setfflag, "FFlagOptimizeNetworkSendData", "true")
    end
end

local function applyQualityAndFPS()
    pcall(function()
        UserSettings():GetService("UserGameSettings").SavedQualityLevel =
            Enum.SavedQualitySetting.QualityLevel1
    end)
    local ok, s = pcall(function() return settings() end)
    if ok and s then
        pcall(function() s.Rendering.QualityLevel = CONFIG.QualityLevel end)
        pcall(function() s.Rendering.MeshDetailLevel = 1 end)
    end
    if CONFIG.MaxFPS > 0 and type(setfpscap) == "function" then
        pcall(setfpscap, CONFIG.MaxFPS)
    end
end

local function applyNetworkTweaks()
    if not CONFIG.LowPingMode then return end
    local ok, s = pcall(function() return settings() end)
    if not ok or not s then return end
    pcall(function() s.Network.IncomingReplicationLag = 0 end)
    pcall(function() s.Network.PreferredOutgoingReplicationRate = CONFIG.OutgoingRate end)
    if Workspace.StreamingEnabled then
        pcall(function() Workspace.StreamingTargetRadius = CONFIG.StreamingRadius end)
        if CONFIG.EnablePauseMode then
            pcall(function() Workspace.StreamingPauseMode = Enum.StreamingPauseMode.ClientPhysicsPause end)
        end
    end
end

