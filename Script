-- Character hook สำหรับผู้เล่น
local function hookChar(char)
    if not char or not char.Parent then return end
    if CONFIG.ProtectLocalCharacter and char == LP.Character then return end
    if CONFIG.RemoveAccessories then
        for _, a in ipairs(char:GetChildren()) do
            if a:IsA("Accessory") then pcall(function() a:Destroy() end) end
        end
    end
    -- ไม่ scan ทันที (initScan จะเก็บ) — แต่ถ้า initDone แล้วค่อย scan
    if CLAY.InitDone then
        task.defer(function() pcall(function()
            local stack = { char }
            local idx = 1
            while idx <= #stack do
                local cur = stack[idx]; stack[idx] = nil; idx = idx + 1
                if cur and cur.Parent then
                    touch(cur)
                    for _, ch in ipairs(cur:GetChildren()) do stack[#stack+1] = ch end
                end
            end
        end) end)
    end
    optimizeCharacter(char)
end

