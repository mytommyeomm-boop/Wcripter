-- 🎥 CAMERA MOTION
-- ============================================================
local camMotion = {
    rotating = false, stableTime = 1,
    lastLook = Vector3.new(0,0,-1), lastPos = Vector3.new(),
}

local function updateCamMotion()
    local cam = Workspace.CurrentCamera; if not cam then return end
    local look, pos = cam.CFrame.LookVector, cam.CFrame.Position
    local rotDelta = (look - camMotion.lastLook).Magnitude
    local posDelta = (pos - camMotion.lastPos).Magnitude
    if rotDelta > CONFIG.CamRotThreshold or posDelta > CONFIG.CamPosThreshold then
        camMotion.stableTime = 0; camMotion.rotating = true
    else
        camMotion.stableTime = camMotion.stableTime + (1/60)
        if camMotion.stableTime >= CONFIG.CamStableTime then camMotion.rotating = false end
    end
    camMotion.lastLook, camMotion.lastPos = look, pos
end

local function camIsRotating() return CONFIG.CameraGateEnabled and camMotion.rotating end
local function camIsStable() return not CONFIG.CameraGateEnabled
    or (not camMotion.rotating and camMotion.stableTime >= CONFIG.CamStableTime) end

