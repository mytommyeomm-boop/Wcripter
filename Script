        if f and f.Parent then
            local t = TweenService:Create(f, TweenInfo.new(0.35),
                {Position = UDim2.new(0.5,-160,0,-90), BackgroundTransparency = 1})
            t:Play(); t.Completed:Wait(); if f then f:Destroy() end
        end
    end)
