        gui.Name, gui.IgnoreGuiInset, gui.ResetOnSpawn, gui.DisplayOrder = "CLAY_NOTIFY", true, false, 10000
        gui.Parent = pg; self:TrackInst(gui)
    end
    local f = Instance.new("Frame")
    f.Size, f.Position = UDim2.new(0,320,0,48), UDim2.new(0.5,-160,0,-90)
    f.BackgroundColor3, f.BackgroundTransparency = Color3.fromRGB(20,18,16), 0.08
    f.BorderSizePixel = 0; f.Parent = gui
    Instance.new("UICorner", f).CornerRadius = UDim.new(0,10)
    local st = Instance.new("UIStroke", f); st.Color, st.Transparency = color, 0.6
    local lb = Instance.new("TextLabel")
    lb.Size, lb.Position = UDim2.new(1,-20,1,-8), UDim2.new(0,12,0,4)
    lb.BackgroundTransparency = 1
    lb.TextColor3, lb.TextScaled, lb.Font = color, true, Enum.Font.GothamBold
    lb.Text, lb.TextXAlignment = text, Enum.TextXAlignment.Left; lb.Parent = f
    TweenService:Create(f, TweenInfo.new(0.35,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),
