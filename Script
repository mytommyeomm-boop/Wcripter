                if CONFIG.ShowToast then
                    CLAY:Notify(string.format("⚠️ เครื่องช้า — ประหยัดสูงสุด", fps, ping),
                        { color = Color3.fromRGB(255,200,120), duration = 6 })
                end
            end
        end))
    end

    -- Success toast
    if CONFIG.ShowToast then
        CLAY:Notify(string.format("✅ พร้อม! Clay %d parts", CLAY.MaterialAppliedCount), {
            color = Color3.fromRGB(120,255,140), duration = CONFIG.ToastDuration })
    end
end))

