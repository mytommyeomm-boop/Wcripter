local function applyLighting()
    pcall(function()
        Lighting.GlobalShadows = not CONFIG.RemoveShadows
        Lighting.ShadowSoftness = 0
        Lighting.Brightness = CONFIG.AggressiveLight and 2.5 or 2
        Lighting.Ambient = Color3.fromRGB(100,98,102)
        Lighting.OutdoorAmbient = Color3.fromRGB(120,118,122)
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.ExposureCompensation = -0.1
        Lighting.ClockTime = CONFIG.ClockTime
        if CONFIG.RemoveAllFog then
            Lighting.FogStart = 0; Lighting.FogEnd = 100000
            Lighting.FogColor = Color3.fromRGB(255, 255, 255)
        end
    end)
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj.Name ~= "CLAY_GRADE" then
            if obj:IsA("PostEffect") then pcall(function() obj:Destroy() end)
            elseif (CONFIG.RemoveAtmosphere and obj:IsA("Atmosphere"))
                or (CONFIG.RemoveClouds and obj:IsA("Clouds")) then
                pcall(function() obj:Destroy() end)
            elseif obj:IsA("Sky") then
                pcall(function() obj.CelestialBodiesShown=false; obj.StarCount=0 end)
            end
        end
    end
    if CONFIG.ClayGrade then
        local cc = Lighting:FindFirstChild("CLAY_GRADE")
        if not cc then
            cc = Instance.new("ColorCorrectionEffect"); cc.Name = "CLAY_GRADE"
            CLAY:TrackInst(cc)
        end
        cc.Parent = Lighting; cc.Saturation = -0.25; cc.Contrast = 0.10
