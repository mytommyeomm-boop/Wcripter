        hl.FillColor = Color3.fromRGB(255,100,100)
        hl.FillTransparency = 0.75
        hl.OutlineColor = Color3.fromRGB(255,100,100)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = char
        hl.Parent = char
    end
    optimizeCharacter(char)
end

