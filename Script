-- ============================================================
-- 🗑️ UNNEEDED OBJECT REMOVER
-- ============================================================
local function resolvePath(path)
    local ok, obj = pcall(function()
        local parts = {}
        for seg in path:gmatch("[^%.]+") do parts[#parts+1] = seg end
        local cur = game
        for _, p in ipairs(parts) do
            cur = cur[p]
            if not cur then return nil end
        end
        return cur
    end)
    return ok and obj or nil
end

local function removeUnneededObjects()
    if not CONFIG.RemoveUnneededObjects then return end
    local removed, skipped = 0, 0
    for _, path in ipairs(CONFIG.UnneededObjectPaths) do
        local obj = resolvePath(path)
        if obj then
            if isProtected(obj) then
                warn(("[CLAY-FPS] ⚠️ ข้าม %s (protected)"):format(path))
                skipped = skipped + 1
            else
                local lpChar = LP.Character
                local isAncestor = false
                if lpChar then
                    local cur = lpChar
                    while cur do
                        if cur == obj then isAncestor = true; break end
                        cur = cur.Parent
                    end
                end
                if isAncestor then
                    warn(("[CLAY-FPS] ⚠️ ข้าม %s (บรรพบุรุษ)"):format(path))
                    skipped = skipped + 1
                else
                    pcall(function() obj:Destroy() end)
                    removed = removed + 1
                    print("[CLAY-FPS] 🗑️ ลบ: " .. path)
                end
            end
        end
    end
    print(("[CLAY-FPS] 🗑️ ลบ %d | ข้าม %d"):format(removed, skipped))
end

-- ============================================================
-- 🧱 MATERIAL BATCH
-- ============================================================
local matQueue, matHead, matTail, matSize = {}, 1, 0, 0

local function queueMaterial(part)
    if not part or not part.Parent then return end
    if part:FindFirstChild("CLAY_HB") or part.Name == "CLAY_BALLPROXY" then return end
    matTail = matTail + 1
    matQueue[matTail] = part
    matSize = matSize + 1
end

local function drainMaterials(maxN)
    if camIsRotating() then
        if CONFIG.CamMaterialDuringMotion <= 0 then return end
        maxN = CONFIG.CamMaterialDuringMotion
    end
    if matSize == 0 then return end
    local n = math.min(matSize, maxN or CONFIG.MatBatchPerFrame)
    for _ = 1, n do
        local p = matQueue[matHead]
        matQueue[matHead] = nil
        matHead = matHead + 1
        matSize = matSize - 1
        if p and p.Parent and not isProtected(p) and not isLocalChar(p)
            and p.Name ~= "CLAY_BALLPROXY" then
            pcall(function()
                if CONFIG.CacheMaterialForRestore and not CLAY.OriginalMaterial[p] then
                    CLAY.OriginalMaterial[p] = {
                        Material = p.Material,
                        Reflectance = p.Reflectance,
                        CastShadow = p.CastShadow,
                        Color = p.Color,
                        TextureID = p:IsA("MeshPart") and p.TextureID or nil,
                    }
                end
                p.Material = Enum.Material.SmoothPlastic
                p.Reflectance = 0
                p.CastShadow = false
                if CONFIG.MuteColors and p.Color then
                    local c = p.Color
                    local g = c.R*0.299 + c.G*0.587 + c.B*0.114
                    p.Color = Color3.new(c.R*0.55+g*0.45, c.G*0.55+g*0.45, c.B*0.55+g*0.45)
                end
                if p:IsA("MeshPart") then
                    if CONFIG.RemoveTextures then p.TextureID = "" end
                    p.MaterialVariant = ""
                end
            end)
        end
    end
    if matHead > 1000 then
        local nq = {}
        for i = matHead, matTail do nq[#nq+1] = matQueue[i] end
        matQueue, matHead, matTail = nq, 1, #nq
    end
end

-- ============================================================
-- 🧱 TOUCH
-- ============================================================
local function touch(inst)
    if not inst or not inst.Parent then return end
    if inst.Name:sub(1,5) == "CLAY_" then return end
    if CLAY.Processed[inst] then return end
    CLAY.Processed[inst] = true
    if isProtected(inst) then return end
    if isLocalChar(inst) then return end

    if CONFIG.RemoveEffects and (inst:IsA("ParticleEmitter") or inst:IsA("Trail")
        or inst:IsA("Beam") or inst:IsA("Smoke")
        or inst:IsA("Fire") or inst:IsA("Sparkles")) then
        pcall(function() inst.Enabled=false; inst:Destroy() end)
        return
    end
    if CONFIG.RemoveLights and inst:IsA("Light") then
        CLAY.HiddenLights[inst] = true
        pcall(function() inst.Enabled = false end)
        return
    end
    if CONFIG.RemoveHighlights and inst:IsA("Highlight") and inst.Name ~= "CLAY_HL" then
        pcall(function() inst:Destroy() end)
        return
    end
    if inst:IsA("SelectionBox") or inst:IsA("SelectionSphere") then
        pcall(function() inst:Destroy() end)
        return
    end
    if CONFIG.KillViewportGui and inst:IsA("ViewportFrame") then
        pcall(function() inst:Destroy() end)
        return
    end
    if inst:IsA("Sound") then handleSound(inst); return end
    if CONFIG.RemoveTextures then
        if inst:IsA("Decal") or inst:IsA("Texture") or inst:IsA("SurfaceAppearance") then
            pcall(function() inst:Destroy() end)
            return
        elseif inst:IsA("SpecialMesh") then
            pcall(function() inst.TextureId = "" end)
        end
    end
    if CONFIG.Remove3DGui and (inst:IsA("BillboardGui") or inst:IsA("SurfaceGui")) then
        pcall(function() inst:Destroy() end)
        return
    end
    if CONFIG.ClayLook and inst:IsA("BasePart") and not inst:IsA("Terrain") then
        if isBall(inst.Name) then initBall(inst); return end
        queueMaterial(inst)
    end
end

