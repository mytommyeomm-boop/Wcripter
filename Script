-- 🔍 SCAN
-- ============================================================
local function scan(root)
    if not root then return end
    local stack, count = { root }, 0
    while #stack > 0 do
        if camIsRotating() then task.wait(); break end
        local cur = table.remove(stack)
        if cur then
            touch(cur)
            for _, ch in ipairs(cur:GetChildren()) do stack[#stack+1] = ch end
            count = count + 1
            if count % CONFIG.YieldEvery == 0 then
                task.wait()
                if not CLAY.Running then return end
            end
        end
    end
end

local function scanBalls(root)
    if not root then return end
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("BasePart") and isBall(d.Name) then initBall(d) end
    end
end

local function hookChar(char)
    if not char then return end
    if CONFIG.ProtectLocalCharacter and char == LP.Character then return end
    if CONFIG.RemoveAccessories then
        for _, a in ipairs(char:GetChildren()) do
            if a:IsA("Accessory") then pcall(function() a:Destroy() end) end
