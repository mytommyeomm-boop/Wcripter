-- ============================================================
-- 🗑️ UNNEEDED OBJECTS (★ staggered)
-- ============================================================
local function resolvePath(path)
    local ok, obj = pcall(function()
        local parts = {}
        for seg in path:gmatch("[^%.]+") do parts[#parts+1] = seg end
        local cur = game
        for _, p in ipairs(parts) do cur = cur[p]; if not cur then return nil end end
        return cur
    end)
    return ok and obj or nil
end

local function removeUnneededStaggered()
    if not CONFIG.RemoveUnneededObjects then return end
    local removed, skipped = 0, 0
    for _, path in ipairs(CONFIG.UnneededObjectPaths) do
        if not CLAY.Running then return end
        local obj = resolvePath(path)
        if obj then
            if isProtected(obj) then
                skipped = skipped + 1
            else
                local lpChar = LP.Character
                local isAncestor = false
                if lpChar then
                    local cur = lpChar
                    while cur do
                        if cur == obj then isAncestor = true; break end
                        cur = cur.Parent
                    end
                end
                if isAncestor then skipped = skipped + 1
                else
                    pcall(function() obj:Destroy() end)
                    removed = removed + 1
                end
            end
        end
        task.wait()  -- ★ yield ระหว่าง path
    end
    print(("[CLAY-FPS] 🗑️ ลบ %d | ข้าม %d"):format(removed, skipped))
end

-- ============================================================
-- 🧱 MATERIAL BATCH
-- ============================================================
local matQueue, matHead, matTail, matSize = {}, 1, 0, 0
local matLastFlush = os.clock()

local function queueMaterial(part)
    if not part or not part.Parent then return end
    if part:FindFirstChild("CLAY_HB") or part.Name == "CLAY_BALLPROXY" then return end
    matTail = matTail + 1; matQueue[matTail] = part; matSize = matSize + 1
end

local function drainMaterials(maxN)
    if camIsRotating() then
        if CONFIG.CamMaterialDuringMotion <= 0 then matLastFlush = os.clock(); return end
        maxN = CONFIG.CamMaterialDuringMotion
    end
    if matSize == 0 then matLastFlush = os.clock(); return end

    local idleTime = os.clock() - matLastFlush
    if idleTime > CONFIG.MatBatchBurstIdle and not camIsRotating() then
        maxN = math.max(maxN or CONFIG.MatBatchPerFrame, CONFIG.MatBatchBurstCount)
    end

    local n = math.min(matSize, maxN or CONFIG.MatBatchPerFrame)
    for _ = 1, n do
        local p = matQueue[matHead]
        matQueue[matHead] = nil
        matHead = matHead + 1; matSize = matSize - 1
        if p and p.Parent and p.Name ~= "CLAY_BALLPROXY" then
            local canApply = CONFIG.ClayMapToo or (not isProtected(p) and not isLocalChar(p))
            if canApply then
                pcall(function()
                    if CONFIG.CacheMaterialForRestore and not CLAY.OriginalMaterial[p] then
                        CLAY.OriginalMaterial[p] = {
                            Material = p.Material, Reflectance = p.Reflectance,
                            CastShadow = p.CastShadow, Color = p.Color,
                            TextureID = p:IsA("MeshPart") and p.TextureID or nil,
                        }
                    end
                    p.Material = Enum.Material.SmoothPlastic
                    p.Reflectance = 0; p.CastShadow = false
                    if CONFIG.MuteColors and p.Color then
                        local c = p.Color
                        local g = c.R*0.299 + c.G*0.587 + c.B*0.114
                        p.Color = Color3.new(c.R*0.55+g*0.45, c.G*0.55+g*0.45, c.B*0.55+g*0.45)
                    end
                    if p:IsA("MeshPart") then
                        if CONFIG.RemoveTextures then p.TextureID = "" end
                        p.MaterialVariant = ""
                    end
                    CLAY.MaterialAppliedCount = CLAY.MaterialAppliedCount + 1
                end)
            end
        end
    end
    matLastFlush = os.clock()
    if matHead > 1000 then
        local nq = {}
        for i = matHead, matTail do nq[#nq+1] = matQueue[i] end
        matQueue, matHead, matTail = nq, 1, #nq
    end
end

-- ============================================================
-- 🧱 TOUCH
-- ============================================================
local function touch(inst)
    if not inst or not inst.Parent then return end
    if inst.Name:sub(1,5) == "CLAY_" then return end
    if CLAY.Processed[inst] then return end
    CLAY.Processed[inst] = true
    if isProtected(inst) and not CONFIG.ClayMapToo then return end
    if isLocalChar(inst) then return end

    if CONFIG.RemoveEffects and (inst:IsA("ParticleEmitter") or inst:IsA("Trail")
        or inst:IsA("Beam") or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles")) then
        pcall(function() inst.Enabled=false; inst:Destroy() end); return
    end
    if CONFIG.RemoveLights and inst:IsA("Light") then
        CLAY.HiddenLights[inst] = true
        pcall(function() inst.Enabled = false end); return
    end
    if CONFIG.RemoveHighlights and inst:IsA("Highlight") and inst.Name ~= "CLAY_HL" then
        pcall(function() inst:Destroy() end); return
    end
    if inst:IsA("SelectionBox") or inst:IsA("SelectionSphere") then
        pcall(function() inst:Destroy() end); return
    end
    if CONFIG.KillViewportGui and inst:IsA("ViewportFrame") then
        pcall(function() inst:Destroy() end); return
    end
    if inst:IsA("Sound") then handleSound(inst); return end
    if CONFIG.RemoveTextures then
        if inst:IsA("Decal") or inst:IsA("Texture") or inst:IsA("SurfaceAppearance") then
            pcall(function() inst:Destroy() end); return
        elseif inst:IsA("SpecialMesh") then
            pcall(function() inst.TextureId = "" end)
        end
    end
    if CONFIG.Remove3DGui and (inst:IsA("BillboardGui") or inst:IsA("SurfaceGui")) then
        pcall(function() inst:Destroy() end); return
    end
    if CONFIG.ClayLook and inst:IsA("BasePart") and not inst:IsA("Terrain") then
        if isBall(inst.Name) then initBall(inst); return end
        queueMaterial(inst)
    end
end

-- ============================================================
-- 🔍 INIT SCAN (★ SINGLE PASS + TIME BUDGET)
-- ============================================================
local function initScan()
    print("[CLAY-FPS] 🔍 เริ่มสแกน workspace...")
    local stack = { Workspace }
    local idx = 1
    local processed = 0
    local lastYield = os.clock()

    while idx <= #stack do
        if not CLAY.Running then return end
        local cur = stack[idx]
        stack[idx] = nil
        idx = idx + 1

        if cur and cur.Parent then
            -- ★ ทุกอย่างในรอบเดียว
            touch(cur)
            if cur:IsA("BasePart") and isBall(cur.Name) then
                initBall(cur)
            elseif cur:IsA("Model") and cur ~= getLPChar()
                and cur:FindFirstChildOfClass("Humanoid") and not isProtected(cur) then
                optimizeCharacter(cur)
            end

            for _, ch in ipairs(cur:GetChildren()) do
                stack[#stack+1] = ch
            end
        end

        processed = processed + 1
        -- ★ Time budget: yield ทุก 3ms
        if os.clock() - lastYield > CONFIG.InitTimeBudget then
            task.wait()
            lastYield = os.clock()
        end
    end
    print(("[CLAY-FPS] ✅ สแกนเสร็จ %d objects"):format(processed))
end

-- ============================================================
-- ⚡ FAST QUEUE (live)
-- ============================================================
local SPECIAL_PROCESS = {
    ParticleEmitter=true, Trail=true, Beam=true, Smoke=true, Fire=true, Sparkles=true,
    PointLight=true, SpotLight=true, SurfaceLight=true, Highlight=true,
    SelectionBox=true, SelectionSphere=true,
    Decal=true, Texture=true, SurfaceAppearance=true, SpecialMesh=true,
    BillboardGui=true, SurfaceGui=true, ViewportFrame=true,
    Sound=true, Accessory=true,
}

local pending, pendingHead, pendingTail, pendingSize = {}, 1, 0, 0

local function enqueue(d)
    if not CLAY.InitDone then return end  -- ★ ระหว่าง init → scan จัดการเอง
    if not (SPECIAL_PROCESS[d.ClassName] or d:IsA("BasePart")) then return end
    if pendingSize >= CONFIG.MaxQueueSize then
        pending[pendingHead] = nil; pendingHead = pendingHead + 1
        pendingSize = pendingSize - 1; CLAY.Dirty = true
    end
    pendingTail = pendingTail + 1; pending[pendingTail] = d; pendingSize = pendingSize + 1
end

local function drain(maxPerFrame)
    if pendingSize == 0 then return end
    local n = math.min(pendingSize, maxPerFrame)
    for _ = 1, n do
        local d = pending[pendingHead]
        pending[pendingHead] = nil
        pendingHead = pendingHead + 1; pendingSize = pendingSize - 1
        if d and d.Parent then touch(d) end
    end
    if pendingHead > 2000 then
        local nq = {}
        for i = pendingHead, pendingTail do nq[#nq+1] = pending[i] end
        pending, pendingHead, pendingTail = nq, 1, #nq
    end
end

local function adaptiveDrainRate()
    local fps = CLAY.Stats.fps
    if fps == 0 then return CONFIG.BaseDrainPerFrame end
    if fps < 25 then return 15 end
    if fps < 40 then return 25 end
    if fps < 55 then return 40 end
    return math.min(80, CONFIG.BaseDrainPerFrame * 2)
end

-- ============================================================
-- 🧹 MEMORY GUARD / AGGRESSIVE
-- ============================================================
local function pruneMemory()
    if camIsRotating() then return end
    local newInst = {}
    for _, i in ipairs(CLAY.Instances) do
        if i and i.Parent then newInst[#newInst+1] = i end
    end
    CLAY.Instances = newInst
    local newConn = {}
    for _, c in ipairs(CLAY.Connections) do
        if c.Connected then newConn[#newConn+1] = c end
    end
    CLAY.Connections = newConn
    if type(collectgarbage) == "function" then pcall(collectgarbage, "step") end
end

local function applyAggressivePass()
    if CLAY.Aggressive or camIsRotating() then return end
    CLAY.Aggressive = true
    CONFIG.RemoveAccessories, CONFIG.Remove3DGui = true, true
    CONFIG.MuteColors, CONFIG.ClayGrade, CONFIG.MuteWorkspaceSFX = true, true, true
    local count = 0
    for _, d in ipairs(Workspace:GetDescendants()) do
        if camIsRotating() then break end
        if isProtected(d) or isLocalChar(d) or d.Name:sub(1,5) == "CLAY_" then
            -- skip
        elseif d:IsA("Accessory") then pcall(function() d:Destroy() end)
        elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") or d:IsA("ViewportFrame") then
            pcall(function() d:Destroy() end)
        elseif d:IsA("Sound") then handleSound(d)
        elseif d:IsA("BasePart") and not d:IsA("Terrain") and not isBall(d.Name) then
            pcall(function()
                if CONFIG.CacheMaterialForRestore and not CLAY.OriginalMaterial[d] then
                    CLAY.OriginalMaterial[d] = {
                        Material = d.Material, Reflectance = d.Reflectance,
                        CastShadow = d.CastShadow, Color = d.Color,
                        TextureID = d:IsA("MeshPart") and d.TextureID or nil,
                    }
                end
                d.Material, d.CastShadow = Enum.Material.SmoothPlastic, false
                if d.Color then
                    local c = d.Color
                    local g = c.R*0.299 + c.G*0.587 + c.B*0.114
                    d.Color = Color3.new(c.R*0.5+g*0.5, c.G*0.5+g*0.5, c.B*0.5+g*0.5)
                end
            end)
        end
        count = count + 1
        if count % 200 == 0 then task.wait() end
    end
    applyLighting()
    if type(collectgarbage) == "function" then pcall(collectgarbage, "step") end
end

