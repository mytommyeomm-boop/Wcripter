-- ========== ฟังก์ชันหา Goal ==========
local function findGoal()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("goal") or n:find("net") or n:find("post") then
                if not obj:IsDescendantOf(LP.Character or game) then
                    return obj
                end
            end
        end
    end
    return nil
end

-- ========== หาศัตรูใกล้สุด ==========
local function findNearestEnemy(char)
    local myTeam = LP.Team
    local myPos = char.HumanoidRootPart.Position
    local nearest, nearestDist = nil, 22

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local ok = true
            if myTeam and plr.Team then
                if plr.Team == myTeam then ok = false end
            end
            if ok then
                local d = (plr.Character.HumanoidRootPart.Position - myPos).Magnitude
                if d < nearestDist then
                    nearestDist = d
                    nearest = plr.Character.HumanoidRootPart.Position
                end
            end
        end
    end
    return nearest
end

-- ========== หาบอล ==========
local function findBall()
    local names = {"ball", "soccerball", "football", "soccer ball"}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            for _, bn in ipairs(names) do
                if n == bn or n:find(bn) then
                    return obj
                end
            end
        end
    end
    return nil
end

-- ========== คำนวณทิศทาง ==========
local function getDirection(char)
    local hrp = char.HumanoidRootPart
    local goal = doGoal and findGoal()
    if goal then
        return (goal.Position - hrp.Position).Unit
    end
    return hrp.CFrame.LookVector
end

-- ========== อัปเดตทิศหลบ ==========
local function applyDodge(char, dir)
    if not doDodge then return dir end
    local enemyPos = findNearestEnemy(char)
    if not enemyPos then return dir end

    local hrp = char.HumanoidRootPart
    local toEnemy = (enemyPos - hrp.Position).Unit
    local right = hrp.CFrame.RightVector

    -- ถ้าศัตรูขวางหน้าอยู่ ให้เบี่ยงข้าง
    if dir:Dot(toEnemy) > 0.45 then
        local side = (right:Dot(toEnemy) > 0) and -1 or 1
        dir = (dir + right * side * 0.9).Unit
    end
    return dir
end

-- ========== ขยับบอล (ถ้าเราเป็นเจ้าของ) ==========
local function tryMoveBall(char)
    local ball = findBall()
    if not ball then return end
    -- เช็ค network ownership
    local ok, owner = pcall(function() return ball:GetNetworkOwner() end)
    if ok and owner == LP then
        local hrp = char.HumanoidRootPart
        local targetPos = hrp.Position + hrp.CFrame.LookVector * 2.2 + Vector3.new(0, 0.8, 0)
        -- interpolate นุ่มๆ
        local newCF = CFrame.new(targetPos) * CFrame.Angles(0, math.atan2(hrp.CFrame.LookVector.X, hrp.CFrame.LookVector.Z), 0)
        ball.CFrame = ball.CFrame:Lerp(newCF, 0.35)
    end
end

-- ========== ลูปหลัก ==========
local function start()
    local char = LP.Character or LP.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")

    connection = RunService.Heartbeat:Connect(function()
        if not isActive then return end
        local c = LP.Character
        if not c or not c:FindFirstChild("HumanoidRootPart") then return end
        local h = c:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then return end

        local dir = getDirection(c)
        dir = applyDodge(c, dir)

        -- ใช้ Move() เหมือนกด joystick
        h:Move(dir * (moveSpeed / 16), false)

        -- ขยับบอลถ้าเป็นเจ้าของ
        tryMoveBall(c)
    end)
end

local function stop()
    isActive = false
    if connection then
        connection:Disconnect()
        connection = nil
    end
    local c = LP.Character
    if c and c:FindFirstChildOfClass("Humanoid") then
        c.Humanoid:Move(Vector3.zero, false)
    end
end

