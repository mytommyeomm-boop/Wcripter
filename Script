-- ============================================================
local function getLPChar() return LP.Character end

local function distFromLocal(pos)
    local c = getLPChar()
    if not c or not c.PrimaryPart then return 0 end
    return (pos - c.PrimaryPart.Position).Magnitude
end

local function freezeCharAnimations(char)
    if CLAY.FrozenChars[char] then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if CONFIG.FreezeAnimationMethod == "None" then return end
    if CONFIG.FreezeAnimationMethod == "Destroy" then
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            pcall(function()
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    pcall(function() track:Stop(0) end)
                end
                animator:Destroy()
            end)
        end
        CLAY.FrozenChars[char] = { destroyed = true }
    else
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            local tracks = {}
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                pcall(function()
                    track:AdjustSpeed(0)
                    tracks[#tracks+1] = track
                end)
            end
            CLAY.FrozenChars[char] = { tracks = tracks }
        end
        pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
    end
end

local function unfreezeCharAnimations(char)
    local rec = CLAY.FrozenChars[char]
    if not rec then return end
    if type(rec) == "table" and rec.tracks then
        for _, track in ipairs(rec.tracks) do
            pcall(function() track:AdjustSpeed(1) end)
        end
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer end)
    end
    CLAY.FrozenChars[char] = nil
end

local function optimizeCharacter(char)
    if not char or char == getLPChar() then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local d = distFromLocal(root.Position)
    if d > CONFIG.FreezeDistance then
        if CONFIG.CleanFarHumanoids and not CLAY.FrozenChars[char] then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
            end
        end
        if CONFIG.FreezeFarAnimators then freezeCharAnimations(char) end
    elseif d < CONFIG.UnfreezeDistance and CLAY.FrozenChars[char] then
        unfreezeCharAnimations(char)
    end
end

local function scanCharacters()
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid")
            and d ~= getLPChar() and not isProtected(d) then
            optimizeCharacter(d)
        end
    end
end

