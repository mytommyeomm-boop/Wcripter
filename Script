local function applyAggressivePass()
    if CLAY.Aggressive or camIsRotating() then return end
    CLAY.Aggressive = true
    CONFIG.RemoveAccessories, CONFIG.Remove3DGui = true, true
    CONFIG.MuteColors, CONFIG.ClayGrade, CONFIG.MuteWorkspaceSFX = true, true, true
    local count = 0
    for _, d in ipairs(Workspace:GetDescendants()) do
        if camIsRotating() then break end
        if isProtected(d) or isLocalChar(d) or d.Name:sub(1,5) == "CLAY_" then
            -- skip
        elseif d:IsA("Accessory") then pcall(function() d:Destroy() end)
        elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") or d:IsA("ViewportFrame") then
            pcall(function() d:Destroy() end)
        elseif d:IsA("Sound") then handleSound(d)
        elseif d:IsA("BasePart") and not d:IsA("Terrain") and not isBall(d.Name) then
            pcall(function()
                if CONFIG.CacheMaterialForRestore and not CLAY.OriginalMaterial[d] then
                    CLAY.OriginalMaterial[d] = {
                        Material = d.Material,
                        Reflectance = d.Reflectance,
                        CastShadow = d.CastShadow,
                        Color = d.Color,
                        TextureID = d:IsA("MeshPart") and d.TextureID or nil,
                    }
                end
                d.Material, d.CastShadow = Enum.Material.SmoothPlastic, false
                if d.Color then
                    local c = d.Color
                    local g = c.R*0.299 + c.G*0.587 + c.B*0.114
                    d.Color = Color3.new(c.R*0.5+g*0.5, c.G*0.5+g*0.5, c.B*0.5+g*0.5)
                end
            end)
        end
        count = count + 1
        if count % 200 == 0 then task.wait() end
    end
    applyLighting()
    if type(collectgarbage) == "function" then pcall(collectgarbage, "step") end
end

