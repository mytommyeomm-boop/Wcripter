                elseif wasRotating and pendingSize > 0 then
                    drain(CONFIG.CamBurstAfter)
                    if pendingSize == 0 then wasRotating = false end
                else
                    drain(adaptiveDrainRate()); wasRotating = false
                end
            end
            RunService.Heartbeat:Wait()
        end
    end))

    -- Material drain (independent)
    CLAY:TrackThread(task.spawn(function()
        while CLAY.Running do
            if not CLAY.Paused then
                local rate = CONFIG.MatBatchPerFrame
                if CONFIG.MatAdaptiveMultiplier then
                    if matSize > 1000 then rate = rate * 10
                    elseif matSize > 500 then rate = rate * 6
                    elseif matSize > 200 then rate = rate * 3 end
                end
                drainMaterials(rate)
            end
            RunService.Heartbeat:Wait()
        end
    end))

    -- Ball sampling
    CLAY:TrackThread(task.spawn(function()
        while CLAY.Running do
            if not CLAY.Paused then
                for ball in pairs(CLAY.BallData) do
                    if ball.Parent then pcall(sampleBall, ball) end
                end
            end
            RunService.Heartbeat:Wait()
        end
    end))

    -- Ball rendering
    CLAY:TrackThread(task.spawn(function()
        while CLAY.Running do
            RunService.RenderStepped:Wait()
            if not CLAY.Paused then pcall(renderBalls) end
        end
    end))

    -- HUD loop
    if CONFIG.ShowHUD then
        CLAY:TrackThread(task.spawn(function()
            local acc, frames, pingAvg = 0, 0, 0
            while CLAY.Running do
                local dt = RunService.RenderStepped:Wait()
                acc, frames = acc + dt, frames + 1
                if acc >= 0.5 then
                    local realFPS = math.floor(frames / acc + 0.5)
                    CLAY.Stats.fps = realFPS
                    CLAY.Stats.frameTime = 1 / math.max(1, realFPS)
                    local ok, p = pcall(function() return pingStat:GetValue() end)
                    if ok then pingAvg = pingAvg * 0.7 + p * 0.3 end
                    CLAY.Stats.ping = math.floor(pingAvg + 0.5)

                    if CONFIG.AutoAggressive and not CLAY.Aggressive
                        and CLAY.Stats.frameTime > CONFIG.FrameTimeAggroThreshold
                        and camIsStable() then
                        task.spawn(function() pcall(applyAggressivePass) end)
                    end

                    if HUD.line and HUD.line.Parent then
                        local disp = math.floor(realFPS * CONFIG.DisplayMultiplier + 0.5)
                        local pCol = pingColor(pingAvg)
                        local hex = string.format("#%02X%02X%02X",
                            math.floor(pCol.R*255), math.floor(pCol.G*255), math.floor(pCol.B*255))
                        HUD.line.Text = string.format(
                            "FPS <b>%d</b> | <font color=\"%s\">Ping %dms</font>",
                            disp, hex, math.floor(pingAvg + 0.5))
                    end
                    if HUD.ball and HUD.ball.Parent then
                        local nBalls, nShot = 0, 0
                        for ball, d in pairs(CLAY.BallData) do
                            if ball.Parent then
                                nBalls = nBalls + 1
                                if d.isShot then nShot = nShot + 1 end
                            end
                        end
                        HUD.ball.Text = string.format("🏐 Ball: %d%s", nBalls,
                            nShot > 0 and string.format(" ⚡%d SHOT", nShot) or "")
                    end
                    acc, frames = 0, 0
                end
            end
        end))
    end

    -- Periodic rescan (90s, gated by Dirty)
    if CONFIG.PeriodicRescan > 0 then
        CLAY:TrackThread(task.spawn(function()
            while CLAY.Running do
                task.wait(CONFIG.PeriodicRescan)
                if CLAY.Running and not CLAY.Paused and camIsStable() and CLAY.Dirty then
                    pcall(initScan)
                    CLAY.Dirty = false
                end
            end
        end))
    end

    -- Memory prune
    if CONFIG.MemoryPruneInterval > 0 then
        CLAY:TrackThread(task.spawn(function()
            while CLAY.Running do
                task.wait(CONFIG.MemoryPruneInterval)
                if CLAY.Running then
                    pcall(pruneMemory)
                    CLAY.HighlightCount = 0
                    if CONFIG.DebugMemory then
                        local mb = math.floor(collectgarbage("count") / 1024)
                        print(string.format("[CLAY-FPS] 💾 %dMB | Q:%d | Mat:%d | Applied:%d",
                            mb, pendingSize, matSize, CLAY.MaterialAppliedCount))
                    end
                end
            end
        end))
    end

    -- Auto-Aggressive fallback
    if CONFIG.AutoAggressive then
        CLAY:TrackThread(task.spawn(function()
            task.wait(CONFIG.AggroAfter)
            if not CLAY.Running or CLAY.Aggressive then return end
            local fps, ping = CLAY.Stats.fps, CLAY.Stats.ping
            if fps > 0 and (fps < CONFIG.AggroFPSThreshold or ping > CONFIG.AggroPingThreshold) then
