local function isBall(name)
    name = name:lower()
    return name:find("ball") or name:find("soccer") or name:find("football")
end

local function initBall(realBall)
    if CLAY.BallData[realBall] then return end
    if not CONFIG.BallSmoothing then
        if CONFIG.BallHighlight then
            local hl = Instance.new("Highlight")
            hl.Name = "CLAY_HL"; hl.FillColor = Color3.fromRGB(255,255,80)
            hl.FillTransparency = 0.75; hl.OutlineColor = Color3.fromRGB(255,255,80)
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = realBall; hl.Parent = realBall
        end
        return
    end

    local proxy = Instance.new("Part")
    proxy.Name = "CLAY_BALLPROXY"
    proxy.Size = realBall.Size; proxy.Color = realBall.Color
    proxy.Material = Enum.Material.SmoothPlastic
    proxy.Transparency = realBall.Transparency
    proxy.CanCollide, proxy.CanTouch, proxy.CanQuery = false, false, false
    proxy.Anchored = true; proxy.CastShadow = false
    proxy.CFrame = realBall.CFrame; proxy.Parent = Workspace
    realBall.LocalTransparencyModifier = 1

    if CONFIG.BallHighlight then
        local hl = Instance.new("Highlight")
        hl.Name = "CLAY_HL"; hl.FillColor = Color3.fromRGB(255,255,80)
        hl.FillTransparency = 0.75; hl.OutlineColor = Color3.fromRGB(255,255,80)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = proxy; hl.Parent = proxy
    end

    local now = os.clock()
    CLAY.BallData[realBall] = {
        proxy = proxy,
        history = { { t = now, pos = realBall.CFrame.Position, rot = realBall.CFrame.Rotation } },
        smoothVel = Vector3.new(), lastSample = now,
        hitbox = nil, isShot = false,
    }

    if CONFIG.EnableHitbox and CONFIG.HitboxSmoothFollow then
        local wrap = Instance.new("Part")
        wrap.Name = "CLAY_HB"
        wrap.Size = proxy.Size + Vector3.new(CONFIG.HitboxAmount, CONFIG.HitboxAmount, CONFIG.HitboxAmount)
        wrap.Transparency = 1
        wrap.CanCollide, wrap.CanTouch, wrap.CanQuery = false, true, false
        wrap.Anchored, wrap.Massless = true, true
        wrap.CFrame = proxy.CFrame; wrap.Parent = proxy
        CLAY.BallData[realBall].hitbox = wrap
    end
end

local function sampleBall(realBall)
    local d = CLAY.BallData[realBall]
    if not d or not realBall.Parent then return end
    local now = os.clock()
    local pos, rot = realBall.CFrame.Position, realBall.CFrame.Rotation
    local last = d.history[#d.history]
    if last then
        local dt = now - last.t
        if dt > 0.001 then
            local instVel = (pos - last.pos) / dt
            if instVel.Magnitude < 800 then
                d.smoothVel = d.smoothVel:Lerp(instVel, CONFIG.BallVelocityEMA)
            else
                d.smoothVel = Vector3.new(); d.history = {}
            end
        end
    end
    table.insert(d.history, { t = now, pos = pos, rot = rot })
    if #d.history > 15 then table.remove(d.history, 1) end
    d.lastSample = now
    d.isShot = d.smoothVel.Magnitude > CONFIG.BallShotSpeedThreshold
end

local function renderBalls()
    if not CONFIG.BallSmoothing then return end
    local now = os.clock()
    local lpPos = LP.Character and LP.Character.PrimaryPart and LP.Character.PrimaryPart.Position
    local pingLead = CONFIG.BallCompensatePing and (math.max(0, CLAY.Stats.ping) / 2000) or 0

    for realBall, d in pairs(CLAY.BallData) do
        if not realBall.Parent or not d.proxy or not d.proxy.Parent then
            if d.proxy then d.proxy:Destroy() end
            pcall(function() realBall.LocalTransparencyModifier = 0 end)
            CLAY.BallData[realBall] = nil
            continue
        end

        local delay = CONFIG.BallBaseDelay
        if lpPos then
            local dist = (realBall.CFrame.Position - lpPos).Magnitude
            if dist < CONFIG.BallNearDistance then delay = CONFIG.BallNearDelay
            elseif dist > CONFIG.BallFarDistance then delay = CONFIG.BallFarDelay
            else
                local t = (dist - CONFIG.BallNearDistance) / (CONFIG.BallFarDistance - CONFIG.BallNearDistance)
                delay = CONFIG.BallNearDelay * (1 - t) + CONFIG.BallFarDelay * t
            end
        end
        if d.isShot then delay = delay * CONFIG.BallShotDelayReduction end

        local renderTime
        if CONFIG.BallPredictionMode == "Lead" then renderTime = now + pingLead - delay
        elseif CONFIG.BallPredictionMode == "Lag" then renderTime = now - delay - pingLead
        else renderTime = now end

        renderTime = math.clamp(renderTime, now - CONFIG.BallMaxDelay, now + CONFIG.BallMaxExtrapolate + pingLead)

        local h = d.history
        if #h < 2 then
            d.proxy.CFrame = realBall.CFrame
        else
            local prev, nxt, found = h[1], h[#h], false
            for i = 1, #h - 1 do
                if h[i].t <= renderTime and h[i+1].t >= renderTime then
                    prev, nxt, found = h[i], h[i+1], true
                    break
                end
            end
            local finalCF
            if found then
                local span = nxt.t - prev.t
                local alpha = span > 0.0001 and math.clamp((renderTime - prev.t) / span, 0, 1) or 0
                finalCF = CFrame.new(prev.pos:Lerp(nxt.pos, alpha)) * prev.rot:Lerp(nxt.rot, alpha)
            else
                local dt = math.clamp(renderTime - h[#h].t, 0, CONFIG.BallMaxExtrapolate)
                finalCF = CFrame.new(h[#h].pos + d.smoothVel * dt) * h[#h].rot
            end
            d.proxy.CFrame = finalCF
        end
        if d.hitbox and d.hitbox.Parent then d.hitbox.CFrame = d.proxy.CFrame end
    end
end

-- ============================================================
-- 👤 CHARACTER OPTIMIZER
-- ============================================================
local function getLPChar() return LP.Character end
local function distFromLocal(pos)
    local c = getLPChar()
    if not c or not c.PrimaryPart then return 0 end
    return (pos - c.PrimaryPart.Position).Magnitude
end

local function freezeCharAnimations(char)
    if CLAY.FrozenChars[char] then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    if CONFIG.FreezeAnimationMethod == "None" then return end
    if CONFIG.FreezeAnimationMethod == "Destroy" then
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            pcall(function()
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    pcall(function() track:Stop(0) end)
                end
                animator:Destroy()
            end)
        end
        CLAY.FrozenChars[char] = { destroyed = true }
    else
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            local tracks = {}
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                pcall(function() track:AdjustSpeed(0); tracks[#tracks+1] = track end)
            end
            CLAY.FrozenChars[char] = { tracks = tracks }
        end
        pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
    end
end

local function unfreezeCharAnimations(char)
    local rec = CLAY.FrozenChars[char]; if not rec then return end
    if type(rec) == "table" and rec.tracks then
        for _, track in ipairs(rec.tracks) do
            pcall(function() track:AdjustSpeed(1) end)
        end
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer end) end
    CLAY.FrozenChars[char] = nil
end

local function optimizeCharacter(char)
    if not char or char == getLPChar() then return end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return end
    local d = distFromLocal(root.Position)
    if d > CONFIG.FreezeDistance then
        if CONFIG.CleanFarHumanoids and not CLAY.FrozenChars[char] then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end) end
        end
        if CONFIG.FreezeFarAnimators then freezeCharAnimations(char) end
    elseif d < CONFIG.UnfreezeDistance and CLAY.FrozenChars[char] then
        unfreezeCharAnimations(char)
    end
end

